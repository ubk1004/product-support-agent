PRODUCT_SUPPORT_CATALOG_LISTING_URL=https://my.opentext.com/support/products/
PRODUCT_SUPPORT_CATALOG_SEARCH_URL=https://my.opentext.com/api/web/support/search-results
PRODUCT_SUPPORT_CATALOG_FEED_URL=https://my.opentext.com/api/web/feed/product
PRODUCT_SUPPORT_CATALOG_MAX_PAGES=20
PRODUCT_SUPPORT_CATALOG_TIMEOUT_SECONDS=10
PRODUCT_SUPPORT_CATALOG_MAX_RESPONSE_BYTES=4194304
PRODUCT_SUPPORT_MAX_DEMO_PRODUCTS=100
PRODUCT_SUPPORT_MANIFEST_SEED=approved-demo-v1
# Approved manifest, documentation source map, and periodic ingestion limits (Phase 3).
PRODUCT_SUPPORT_MANIFEST_PATH=docs/operations/phase-2-product-manifest-v1.json
PRODUCT_SUPPORT_SOURCE_MAP_PATH=docs/operations/phase-3-source-map-v1.json
PRODUCT_SUPPORT_MONGODB_URI=mongodb://127.0.0.1:27017
PRODUCT_SUPPORT_SOURCE_USER_AGENT=product-support-agent/0.1 (demo documentation indexer)
PRODUCT_SUPPORT_SOURCE_REQUEST_BUDGET=400
PRODUCT_SUPPORT_SOURCE_MIN_REQUEST_INTERVAL_SECONDS=1
PRODUCT_SUPPORT_SOURCE_MAX_RETRY_AFTER_SECONDS=60
PRODUCT_SUPPORT_SOURCE_SUCCESS_FRESHNESS_HOURS=24
PRODUCT_SUPPORT_SOURCE_TRANSIENT_FAILURE_BACKOFF_HOURS=24
PRODUCT_SUPPORT_SOURCE_PERMANENT_FAILURE_BACKOFF_DAYS=30
PRODUCT_SUPPORT_SOURCE_FAIL_FAST_CONSECUTIVE_FAILURES=3


# ---------- Azure OpenAI ----------
# OpenAI-compatible Foundry endpoint ending in /openai/v1
AZURE_OPENAI_ENDPOINT=https://{YOUR-DEPLOYMENT-NAME}.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=YOUR_API_KEY_HERE
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://{YOUR-DEPLOYMENT-NAME}.services.ai.azure.com/openai/v1/
AZURE_AI_SEARCH_ENDPOINT=https://{YOUR-SEARCH-SERVICE-NAME}.search.windows.net
AZURE_AI_SEARCH_API_KEY=YOUR_API_KEY_HERE
PRODUCT_SUPPORT_SEARCH_EMBEDDING_MODEL_VERSION=text-embedding-3-small
PRODUCT_SUPPORT_SEARCH_EMBEDDING_DIMENSIONS=1536
PRODUCT_SUPPORT_SEARCH_DEMO_INDEX_BASE=product-support-demo
PRODUCT_SUPPORT_SEARCH_TEST_INDEX_BASE=product-support-test
# OpenTelemetry (traces, metrics, logs; metadata only, never question or answer text).
# Compose sets OTEL_EXPORTER_OTLP_ENDPOINT to the bundled Aspire dashboard (http://127.0.0.1:18888).
# For a process run outside Compose, point it at http://127.0.0.1:4318 or an Arize Phoenix collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
PRODUCT_SUPPORT_TELEMETRY_ENABLED=true
# Also read: PRODUCT_SUPPORT_TELEMETRY_CONSOLE (write telemetry to stdout) and
# PRODUCT_SUPPORT_TELEMETRY_METRIC_INTERVAL_MS (default 15000).
PRODUCT_SUPPORT_TELEMETRY_CONSOLE=false
PRODUCT_SUPPORT_TELEMETRY_METRIC_INTERVAL_MS=15000
# Deployment environment label: local, test, or production. Any other value stops the API at startup.
PRODUCT_SUPPORT_ENVIRONMENT=local
# Azure Monitor (cloud). With managed identity, set the flag and AZURE_CLIENT_ID of the identity.
APPLICATIONINSIGHTS_CONNECTION_STRING=
PRODUCT_SUPPORT_TELEMETRY_USE_MANAGED_IDENTITY=false
# AZURE_CLIENT_ID=
# Web only: service name reported by Next.js telemetry (default product-support-web).
# OTEL_SERVICE_NAME=
# Server-side URL Next.js uses to call FastAPI; defaults to the loopback API.
# PRODUCT_SUPPORT_API_BASE_URL=http://127.0.0.1:8000

# Ingestion queue (one message per product). Compose sets these for Azurite; set them only for a
# process run outside Compose. In Azure, set PRODUCT_SUPPORT_QUEUE_ACCOUNT_URL instead and the
# job signs in with its managed identity.
# PRODUCT_SUPPORT_QUEUE_ACCOUNT_URL=https://{STORAGE-ACCOUNT}.queue.core.windows.net
PRODUCT_SUPPORT_QUEUE_CONNECTION_STRING=UseDevelopmentStorage=true
PRODUCT_SUPPORT_QUEUE_API_VERSION=2026-06-06
PRODUCT_SUPPORT_INGESTION_QUEUE_NAME=product-ingestion
PRODUCT_SUPPORT_POISON_DEQUEUE_COUNT=5
